{
  "manifest_version": 3,
  "name": "chrome-print-2-pdf",
  "version": "1.0.0",
  "description": "One click saves the current page as a PDF under your Downloads folder.",
  "permissions": ["debugger", "downloads", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Save PDF",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "save-pdf": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the current page as PDF"
    }
  }
}
